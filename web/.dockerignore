# =============================================================================
# WEB .DOCKERIGNORE - Exclude unnecessary files from Docker build context
# =============================================================================
# This file reduces build context size and improves Vite build speed
# =============================================================================

# Node modules (will be installed via npm ci)
node_modules
npm-debug.log
yarn-error.log
# NOTE: package-lock.json is REQUIRED for npm ci - do NOT exclude it

# Build output (will be generated during Vite build)
dist
build
.vite
*.tsbuildinfo

# Environment files (use VITE_ prefixed env vars in docker-compose)
.env
.env.*
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode
.idea
*.swp
*.swo
*.swn
.project
.classpath
.settings
.editorconfig

# Git files
.git
.gitignore
.gitattributes
.github

# Test and coverage
coverage
*.coverage
.nyc_output
test-results
.vitest

# Documentation
*.md
README.md
CONTRIBUTING.md
CHANGELOG.md

# CI/CD files
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
.circleci

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# Vite cache
.vite-cache
node_modules/.vite

# ESLint cache
.eslintcache

# Temporary files
*.tmp
*.temp
.cache
.temp

# Editor backups
*~
*.bak
*.backup

# Storybook (if used)
storybook-static
